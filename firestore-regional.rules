rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions - Servidor Regional (gen-lang-client-0111023338)
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      let path = /databases/$(database)/documents/artifacts/gen-lang-client-0111023338/public/data/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {"role": "none", "unidade": "none"};
    }
    
    function isMasterUser() {
      let path = /databases/$(database)/documents/artifacts/gen-lang-client-0111023338/public/data/users/$(request.auth.uid);
      let userDoc = exists(path) ? get(path).data : {"email": "none", "role": "none"};
      return isAuthenticated() && (
        request.auth.token.email in ["canaldonutri@gmail.com", "marcos.teixeira@estacio.br"] || 
        userDoc.email in ["canaldonutri@gmail.com", "marcos.teixeira@estacio.br"] ||
        userDoc.role in ["Administrador", "Admin Master"]
      );
    }
    
    function hasAnyRole(roles) {
      let data = getUserData();
      return isAuthenticated() && (
        isMasterUser() ||
        data.role in roles
      );
    }
    
    function isAdministrador() { 
      return isMasterUser() || hasAnyRole(['Administrador', 'Admin Master']); 
    }
    
    function isGerenteRegionalSM() { 
      return hasAnyRole(['Gerente Regional SM', 'Administrador', 'Admin Master']); 
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.name is string &&
             data.role in ['Administrador', 'Gerente Regional SM', 'Admin Master'] &&
             (!('unidade' in data) || data.unidade is string);
    }

    function isValidFuncionario(data) {
      return data.keys().hasAll(['nome', 'matricula']) &&
             data.nome is string && data.nome.size() > 0 &&
             data.matricula is string &&
             (!('email' in data) || data.email is string) &&
             (!('tipo' in data) || data.tipo is string) &&
             (!('cargo' in data) || data.cargo is string) &&
             (!('unidade' in data) || data.unidade is string) &&
             (!('telefone' in data) || data.telefone is string) &&
             (!('dataNascimento' in data) || data.dataNascimento is string);
    }

    function isValidLinkUtil(data) {
      return data.keys().hasAll(['nome', 'url']) &&
             data.nome is string && data.nome.size() > 0 &&
             data.url is string && data.url.size() > 0;
    }

    function isValidChecklistItem(data) {
      return data.keys().hasAll(['titulo']) &&
             data.titulo is string && data.titulo.size() > 0;
    }

    function isValidFormConfig(data) {
      return data.keys().hasAll(['titulo', 'campos']) &&
             data.titulo is string &&
             data.campos is list;
    }

    // ===============================================================
    // Root Artifacts Path - Regional Server
    // ===============================================================
    
    match /artifacts/gen-lang-client-0111023338/public/data {
      
      // Users collection
      match /users/{userId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          isAdministrador() || 
          request.auth.uid == userId ||
          request.auth.token.email in ["canaldonutri@gmail.com", "marcos.teixeira@estacio.br"]
        );
        allow update: if isAuthenticated() && (
          isAdministrador() || 
          request.auth.uid == userId
        );
        allow delete: if isAdministrador();
      }

      // Funcionários SM
      match /funcionarios/{funcionarioId} {
        allow read: if isGerenteRegionalSM();
        allow write: if isGerenteRegionalSM();
      }

      // Links Úteis
      match /linksUteis/{linkId} {
        allow read: if isAuthenticated();
        allow write: if isGerenteRegionalSM();
      }

      // Checklists
      match /checklist/{itemId} {
        allow read: if isGerenteRegionalSM();
        allow write: if isGerenteRegionalSM();
      }

      // Relatórios
      match /relatorios/{reportId} {
        allow read: if isGerenteRegionalSM();
        allow write: if isGerenteRegionalSM();
      }

      // Formulários
      match /forms_config/{formId} {
        allow read: if true; // Public forms can be read
        allow write: if isGerenteRegionalSM();
      }

      match /formularios_respostas/{respostaId} {
        allow read: if isGerenteRegionalSM();
        allow create: if true; // Public submission
        allow update, delete: if isAdministrador();
      }

      // Bot Config / Telemetria
      match /bot_config/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAdministrador();
      }

      match /bot_reports/{docId} {
        allow read: if isGerenteRegionalSM();
        allow write: if isGerenteRegionalSM();
      }

      // General fallback for regional subcollections
      match /{collectionName}/{docId} {
        allow read, write: if isGerenteRegionalSM();
      }
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
